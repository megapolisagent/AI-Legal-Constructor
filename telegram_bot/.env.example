# Скопируйте этот файл в .env (без .example) и заполните.

# Токен бота — получить у @BotFather в Telegram: команда /newbot
BOT_TOKEN=

# Ваш личный Telegram ID через запятую (можно несколько) — без этого бот никому не отвечает.
# Узнать свой ID: напишите боту что угодно после первого запуска, он покажет ваш ID в ответ.
ALLOWED_USER_IDS=
